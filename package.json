{
  "name": "best-workspace",
  "version": "1.0.3",
  "private": true,
  "description": "BEST Ultimate Workspace — monorepo (server + gui)",
  "workspaces": ["server", "gui"],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:gui": "npm run dev -w gui",
    "build": "npm run build -w server && npm run build -w gui",
    "build:server": "npm run build -w server",
    "build:gui": "npm run build -w gui",
    "start": "node scripts/start-prod.mjs",
    "seed": "npm run seed -w server"
  },
  "engines": {
    "node": ">=20"
  }
}
