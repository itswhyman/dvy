# Leave empty in production (same-origin → relative /api via rewrite)
# Or set full public API URL if API is on another host:
# NEXT_PUBLIC_API_URL=https://api.dovye.com.tr/api
NEXT_PUBLIC_API_URL=

# WebSocket (optional; same origin uses /socket.io rewrite)
NEXT_PUBLIC_WS_URL=

# Server-side only — used by next.config rewrites (Coolify internal network)
# API_INTERNAL_URL=http://server:4000
# or: API_INTERNAL_URL=http://127.0.0.1:4000
